{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/support-triage-v1.json",
  "title": "Synthetic support ticket triage handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_version",
    "dataset_id",
    "tickets"
  ],
  "properties": {
    "workflow_version": {
      "const": "1.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "tickets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/triagedTicket"
      }
    }
  },
  "$defs": {
    "triagedTicket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket_id",
        "category",
        "priority",
        "sentiment",
        "summary",
        "recommended_action",
        "confidence",
        "needs_clarification",
        "information_gaps",
        "source_evidence"
      ],
      "properties": {
        "ticket_id": {
          "type": "string",
          "pattern": "^TKT-[0-9]{3}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "account_access",
            "billing",
            "feature_request",
            "service_outage",
            "technical",
            "other"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "sentiment": {
          "type": "string",
          "enum": [
            "negative",
            "neutral",
            "positive"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "recommended_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_clarification": {
          "type": "boolean"
        },
        "information_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uniqueItems": true
        },
        "source_evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      }
    }
  }
}

